#!/usr/bin/env bash
# Root-side helper for elsec-tunl-tui. Installed root:root 0755 at /usr/local/bin/elsec-tunl-priv
# and allowed via sudoers for the `elsec-tunl` group. Only operates on configs in
# /etc/wireguard by name and never prints private or preshared keys.
set -euo pipefail
export PATH=/usr/bin:/usr/sbin
CONF_DIR=/etc/wireguard

usage() {
  echo "usage: elsec-tunl-priv list | status | up NAME | down NAME" >&2
  exit 2
}

valid_name() {
  [[ $1 =~ ^[a-zA-Z0-9_=+.-]{1,15}$ ]] && [[ -f $CONF_DIR/$1.conf ]]
}

case "${1:-}" in
  list)
    shopt -s nullglob
    for f in "$CONF_DIR"/*.conf; do
      basename "$f" .conf
    done
    ;;
  status)
    # Interface lines: iface priv pub port fwmark  -> iface pub port fwmark
    # Peer lines:      iface pub psk endpoint ips hs rx tx keepalive -> psk replaced with "-"
    wg show all dump | awk 'BEGIN { FS = OFS = "\t" }
      NF == 5 { print $1, $3, $4, $5; next }
      NF == 9 { $3 = "-"; print; next }'
    ;;
  up|down)
    [[ $# -eq 2 ]] || usage
    valid_name "$2" || { echo "elsec-tunl-priv: unknown tunnel '$2'" >&2; exit 1; }
    exec wg-quick "$1" "$2"
    ;;
  *)
    usage
    ;;
esac
